---
import '@fontsource-variable/onest'
import '../styles/global.css';
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
	title: string
	lang: Lang
	description?: string
	/** Path after the language prefix, e.g. "personal/wishlist/" */
	path?: string
}

const { title, lang, description, path = "" } = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head lang={lang} title={title} description={description ?? t("meta.description")} path={path} />
  </head>

  <body>
	<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-radial-[at_top] from-gray-700 via-gray-900 to-black"></div>
    <Header lang={lang} />
    <slot />
	<Footer lang={lang} />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }

  html {
    font-family: "Onest Variable", system-ui, sans-serif;
	scroll-behavior: smooth;
  }

  body {
	position: relative;
	background: #050505;
  	display: flex;
	flex-direction: column;
	justify-content: center;
	min-height: 100vh;
  }

  @media (prefers-reduced-motion: reduce){
  	html {
		  scroll-behavior: auto;
    }
  }
</style>
