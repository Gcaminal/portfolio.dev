---
import '@fontsource-variable/onest'
import '../styles/global.css';
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
	title: string
	lang: Lang
	description?: string
	/** Path after the language prefix, e.g. "personal/wishlist/" */
	path?: string
}

const { title, lang, description, path = "" } = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <Head lang={lang} title={title} description={description ?? t("meta.description")} path={path} />
  </head>

  <body>
	<div aria-hidden="true" class="bg-dark pointer-events-none absolute inset-0 -z-10 bg-radial-[at_top] from-gray-700 via-gray-900 to-black"></div>
	<div aria-hidden="true" class="bg-light pointer-events-none absolute inset-0 -z-10"></div>
    <Header lang={lang} />
    <slot />
	<Footer lang={lang} />
  </body>
</html>

<style is:global>
  html {
    font-family: "Onest Variable", system-ui, sans-serif;
	scroll-behavior: smooth;
  }

  body {
	position: relative;
	background: var(--page-bg);
  	display: flex;
	flex-direction: column;
	min-height: 100vh;
	/* Side margins on phones/tablets; sections set their own width from lg up */
	padding-inline: 1.25rem;
	/* Nothing may be wider than the screen (it makes phones zoom out and shift left) */
	overflow-x: clip;
  }
  /* Content fills the height so the footer stays at the bottom on short pages */
  body > main {
	flex: 1;
  }
  @media (min-width: 768px) {
	body {
		padding-inline: 2rem;
	}
  }

  /* Light theme: white page with soft, irregular grey patches (only one background shows) */
  .bg-light {
	display: none;
	background:
		radial-gradient(ellipse 55% 30% at 12% 6%, rgb(17 24 39 / 0.14), transparent 70%),
		radial-gradient(ellipse 45% 25% at 88% 18%, rgb(17 24 39 / 0.11), transparent 70%),
		radial-gradient(ellipse 60% 22% at 28% 42%, rgb(17 24 39 / 0.12), transparent 70%),
		radial-gradient(ellipse 40% 28% at 82% 63%, rgb(17 24 39 / 0.11), transparent 70%),
		radial-gradient(ellipse 55% 25% at 18% 88%, rgb(17 24 39 / 0.13), transparent 70%);
  }
  [data-theme="light"] .bg-light {
	display: block;
  }
  [data-theme="light"] .bg-dark {
	display: none;
  }

  @media (prefers-reduced-motion: reduce){
  	html {
		  scroll-behavior: auto;
    }
  }
</style>
