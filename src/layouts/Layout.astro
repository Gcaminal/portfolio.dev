---
import '@fontsource-variable/onest'
import '../styles/global.css';
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro';
import { langs, useTranslations, type Lang } from '../i18n/ui';

interface Props {
	title: string
	lang: Lang
}

const { title, lang } = Astro.props;
const t = useTranslations(lang);
const pageUrl = new URL(`/${lang}/`, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="google-site-verification" content="NbymEV6R3d79ZsP-LnOBo6O_Vq3syLUCdHOG60t_ZOQ" />
    <meta name="description" content={t("meta.description")} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/Gerard_Caminal.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="canonical" href={pageUrl} />
    {langs.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(`/${l}/`, Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={t("meta.description")} />
    <meta property="og:image" content="https://gerard-caminal.netlify.app/og-image.png" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t("meta.locale")} />
    {langs.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={useTranslations(l)("meta.locale")} />
    ))}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
	<div class="absolute top-0 z-[-2] h-screen w-screen bg-radial-[at_top] from-gray-700 via-gray-900 to-black"></div>
    <Header lang={lang} />
    <slot />
	<Footer lang={lang} />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }

  html {
    font-family: "Onest Variable", system-ui, sans-serif;
	scroll-behavior: smooth;
  }

  body {
	background: #050505;
  	display: flex;
	flex-direction: column;
	justify-content: center;
	min-height: 100vh;
  }

  @media (prefers-reduced-motion: reduce){
  	html {
		  scroll-behavior: auto;
    }
  }
</style>
