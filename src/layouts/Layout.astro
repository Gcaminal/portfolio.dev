---
import '@fontsource-variable/onest'
import '../styles/global.css';
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro';

interface Props {
	title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Portfolio de Gerard" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/Gerard_Caminal.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Gerard Caminal — Portfolio</title>

    <meta property="og:title" content="Gerard Caminal — Portfolio" />
    <meta property="og:description" content="Consultor tecnológico en Deloitte y estudiante de Máster en Data Science." />
    <meta property="og:image" content="https://gerard-caminal.netlify.app/Gerard_Caminal.png" />
    <meta property="og:url" content="https://gerard-caminal.netlify.app" />
    <meta property="og:type" content="website" />
  </head>

  <body>
	<div class="absolute top-0 z-[-2] h-screen w-screen bg-radial-[at_top] from-gray-700 via-gray-900 to-black"></div>
    <Header />
    <slot />
	<Footer /> 
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }

  html {
    font-family: "Onest Variable", system-ui, sans-serif;
	scroll-behavior: smooth;
  }
	
  body {
	background: #050505;
  	display: flex;
	flex-direction: column;
	justify-content: center;
	min-height: 100vh;
  }

  @media (prefers-reduced-motion: reduce){
  	html {
		  scroll-behavior: auto;
    }
  }
</style>