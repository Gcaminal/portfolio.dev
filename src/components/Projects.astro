---
import GitHubIcon from "./icons/GitHub.astro";

const PROJECTS = [
    {
        title: 'Canon',
        description: 'Un guardián de continuidad narrativa impulsado por IA que ayuda a escritores, estudios de videojuegos y equipos de marca a mantener la coherencia en proyectos creativos largos, comprobando cada nuevo borrador contra el canon ya establecido.',
        link: '',
        GitHub: 'https://github.com/Gcaminal/Canon',
        image: '/projects/canon-banner.png',
        tags: ['Python', 'AI']
    },
    {
        title: 'Análisis del rendimiento académico universitario',
        description: 'Análisis exploratorio y modelado del rendimiento de estudiantes universitarios en Catalunya a partir de datasets públicos, aplicando técnicas de ciencia de datos con Python en el marco del Máster en Data Science.',
        link: '',
        GitHub: 'https://github.com/Gcaminal/UOC_Programacio_ciencia_dades_CATPEC4',
        image: '/projects/uni-banner.webp',
        tags: ['Python', 'Data Science']
    }
]
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, GitHub }) => (
      <article class="flex flex-col space-x-0 space-y-6 group md:flex-row md:space-x-10 md:space-y-0">
        <div class="w-full md:w-3/5">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition-all duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-[0_20px_60px_-10px_rgba(255,255,255,0.1)] lg:border lg:border-gray-800 lg:hover:border-white/30 lg:hover:bg-gray-800/50 h-48 md:h-56">
            <img
                alt={title}
                class="object-cover object-center w-full h-full transition duration-500 md:group-hover:scale-105"
                loading="lazy"
                src={image}
            />
            <div
                class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
                aria-hidden="true"
            />
            </div>
        </div>
        <div class="w-full md:w-1/2 md:max-w-lg flex flex-col justify-center">
          <h3 class="text-2xl font-bold text-white">{title}</h3>
          <ul class="flex flex-row flex-wrap mt-3 gap-2">
            {tags.map((tag) => (
              <li>
                <span class="flex gap-x-2 rounded-full text-xs bg-blue-600 text-white py-1 px-2">
                  {tag}
                </span>
              </li>
            ))}
          </ul>
          <p class="mt-3 text-gray-300 text-pretty">{description}</p>
          <footer class="flex items-center mt-4 gap-x-4">
            {GitHub && (
              <a
                href={GitHub}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-x-2 rounded-full border border-white/20 px-3 py-1 text-sm text-white hover:bg-white/10 transition"
              >
                <GitHubIcon class="size-6" />
                Code
              </a>
            )}
          </footer>
        </div>
      </article>
    ))
  }
</div>