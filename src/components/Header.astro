---
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="flex justify-between items-center py-4 w-full xl:w-[1120px] mx-auto">
    <img
        class="rounded-full w-12 h-12"
        src="/Gerard_Caminal.png"
        alt={t("header.photoAlt")}
    />

    <nav class="flex flex-row items-center gap-x-10">
        <a class="opacity-70 hover:opacity-100" href="#top">{t("nav.home")}</a>
        <a class="opacity-70 hover:opacity-100" href="#experience">{t("nav.experience")}</a>
        <a class="opacity-70 hover:opacity-100" href="#projects">{t("nav.projects")}</a>
        <a class="opacity-70 hover:opacity-100" href="#about">{t("nav.about")}</a>
        <a class="opacity-70 hover:opacity-100" href="#contact">{t("nav.contact")}</a>
    </nav>
</header>
