---
import { langs, localePath, useTranslations, type Lang } from "../i18n/ui";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang, "/");
---

<header id="site-header" class="relative flex justify-between items-center gap-4 py-4 w-full xl:w-[1120px] mx-auto">
    <a href={`${home}#top`} class="shrink-0">
        <img
            class="rounded-full size-10 md:size-12"
            src="/Gerard_Caminal.png"
            alt={t("header.photoAlt")}
        />
    </a>

    <div class="flex items-center gap-x-2 md:gap-x-6 lg:gap-x-10">
        {/* Desktop: inline links. Mobile: drop-down panel opened with the menu button */}
        <nav id="site-nav" class="site-nav md:flex md:flex-row md:items-center md:gap-x-6 lg:gap-x-10">
            <a class="opacity-70 hover:opacity-100" href={`${home}#top`}>{t("nav.home")}</a>
            <a class="opacity-70 hover:opacity-100" href={`${home}#experience`}>{t("nav.experience")}</a>
            <a class="opacity-70 hover:opacity-100" href={`${home}#projects`}>{t("nav.projects")}</a>
            <a class="opacity-70 hover:opacity-100" href={`${home}#about`}>{t("nav.about")}</a>
            <a class="opacity-70 hover:opacity-100" href={`${home}#contact`}>{t("nav.contact")}</a>
        </nav>

        <div class="flex items-center gap-1 text-xs font-medium" role="group" aria-label={t("header.language")}>
            {langs.map((l) => (
                <button
                    type="button"
                    data-set-lang={l}
                    lang={l}
                    aria-pressed={String(l === lang)}
                    class:list={[
                        "rounded-md px-2 py-1 uppercase transition",
                        l === lang
                            ? "bg-white/15 text-white"
                            : "text-white/50 hover:text-white hover:bg-white/5",
                    ]}
                >
                    {l}
                </button>
            ))}
        </div>

        <button
            type="button"
            id="theme-toggle"
            class="theme-toggle grid size-9 place-items-center rounded-full transition hover:bg-white/10"
            aria-label={t("header.themeLight")}
            data-label-light={t("header.themeLight")}
            data-label-dark={t("header.themeDark")}
        >
            {/* Shows the current theme: moon = dark, sun = light */}
            <svg class="icon-moon size-5" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
            <svg class="icon-sun size-5" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="12" cy="12" r="4.5" fill="currentColor" stroke="none" />
                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
        </button>

        <button
            type="button"
            id="menu-toggle"
            class="grid size-9 place-items-center rounded-full text-white transition hover:bg-white/10 md:hidden"
            aria-label={t("header.menu")}
            aria-controls="site-nav"
            aria-expanded="false"
        >
            <svg class="icon-menu size-5" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <svg class="icon-close size-5" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M6 6l12 12M18 6L6 18" />
            </svg>
        </button>
    </div>
</header>

<style>
    /* Mobile menu panel (below md the links don't fit in one row) */
    @media (max-width: 767.98px) {
        .site-nav {
            display: none;
            position: absolute;
            top: 100%;
            right: 0;
            left: 0;
            z-index: 50;
            flex-direction: column;
            padding: 0.5rem;
            border: 1px solid color-mix(in oklab, var(--fg) 10%, transparent);
            border-radius: 0.75rem;
            background: color-mix(in oklab, var(--page-bg) 92%, transparent);
            backdrop-filter: blur(16px);
        }
        .site-nav a {
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
        }
        .site-nav a:hover {
            background: color-mix(in oklab, var(--fg) 6%, transparent);
        }
        .menu-open .site-nav {
            display: flex;
        }
    }
    .icon-close,
    .menu-open .icon-menu {
        display: none;
    }
    .menu-open .icon-close {
        display: block;
    }
    .icon-moon {
        color: #6ee7b7;
    }
    .icon-sun {
        display: none;
        color: #f59e0b;
    }
    :global([data-theme="light"]) .icon-moon {
        display: none;
    }
    :global([data-theme="light"]) .icon-sun {
        display: block;
    }
</style>

<script>
    // Mobile menu: open/close, and close after picking a link, pressing Esc or tapping outside
    const header = document.getElementById("site-header")!;
    const menuBtn = document.getElementById("menu-toggle") as HTMLButtonElement;
    const setMenu = (open: boolean) => {
        header.classList.toggle("menu-open", open);
        menuBtn.setAttribute("aria-expanded", String(open));
    };
    menuBtn.addEventListener("click", () => setMenu(!header.classList.contains("menu-open")));
    header.querySelectorAll("#site-nav a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
    document.addEventListener("keydown", (e) => e.key === "Escape" && setMenu(false));
    document.addEventListener("click", (e) => !header.contains(e.target as Node) && setMenu(false));

    // Light/dark switch: data-theme on <html>, remembered in localStorage (see Head.astro)
    const themeBtn = document.getElementById("theme-toggle") as HTMLButtonElement;
    const syncThemeLabel = () => {
        const light = document.documentElement.dataset.theme === "light";
        themeBtn.setAttribute("aria-label", (light ? themeBtn.dataset.labelDark : themeBtn.dataset.labelLight) ?? "");
    };
    themeBtn.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
        document.documentElement.dataset.theme = next;
        try {
            localStorage.setItem("theme", next);
        } catch {}
        syncThemeLabel();
    });
    syncThemeLabel();

    // Language switch. Netlify reads the nf_lang cookie to decide which build to serve at the
    // same URL (see public/_redirects), so switching = set cookie + reload. In local dev there
    // is no Netlify, so jump between "/..." (English) and "/es/..." (Spanish) instead.
    document.querySelectorAll<HTMLButtonElement>("[data-set-lang]").forEach((btn) => {
        btn.addEventListener("click", () => {
            const lang = btn.dataset.setLang!;
            if (btn.getAttribute("aria-pressed") === "true") return;
            document.cookie = `nf_lang=${lang}; path=/; max-age=31536000; SameSite=Lax`;
            if (import.meta.env.DEV) {
                const path = location.pathname.replace(/^\/es(?=\/|$)/, "") || "/";
                location.href = (lang === "es" ? `/es${path}` : path) + location.hash;
            } else {
                location.reload();
            }
        });
    });
</script>
