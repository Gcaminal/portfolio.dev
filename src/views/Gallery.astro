---
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { localePath, useTranslations, type Lang } from "../i18n/ui";
import { GALLERY } from "../data/gallery";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const num = (i: number) => String(i + 1).padStart(2, "0");

// Muted, no YouTube UI; enablejsapi lets our buttons control it via postMessage.
// No loop/playlist params: YouTube's loop turns it into a playlist with prev/next buttons,
// so looping is done in the script below instead.
const youtubeSrc = (id: string) =>
	`https://www.youtube-nocookie.com/embed/${id}?` +
	new URLSearchParams({
		autoplay: "1",
		mute: "1",
		controls: "0",
		disablekb: "1",
		playsinline: "1",
		rel: "0",
		iv_load_policy: "3",
		modestbranding: "1",
		enablejsapi: "1",
	});
---

<Layout
	title={t("gallery.metaTitle")}
	lang={lang}
	description={t("gallery.intro")}
	path="personal/gallery/"
>
	<main>
		<SectionContainer class="pt-32 lg:pt-44">
			<Breadcrumb
				items={[
					{ label: t("breadcrumb.home"), href: localePath(lang, "/") },
					{ label: t("section.beyond"), href: localePath(lang, "/personal/") },
					{ label: t("personal.gallery") },
				]}
			/>
			<h1 class="text-white text-3xl md:text-4xl lg:text-5xl font-bold pt-6 pb-6 lg:pb-8">
				{t("gallery.title")}
			</h1>
			<p class="text-base lg:text-lg opacity-90 max-w-[700px] text-pretty">{t("gallery.intro")}</p>
		</SectionContainer>

		<ul class="w-full mx-auto lg:w-[740px] pb-24 grid gap-6">
			{GALLERY.map((item, i) => (
				<li class="tile relative aspect-video min-w-0 overflow-hidden rounded-xl border border-white/10 bg-black">
					{item.type === "image" && (
						<img src={item.src} alt={item.alt} loading="lazy" class="h-full w-full object-cover" />
					)}

					{item.type === "video" && (
						<div class:list={["video h-full w-full", { letterbox: "letterbox" in item && item.letterbox }]} data-kind={"youtube" in item ? "youtube" : "file"}>
							{"youtube" in item ? (
								<>
									<iframe
										class="media yt"
										src={youtubeSrc(item.youtube)}
										title={item.title}
										loading="lazy"
										allow="autoplay; encrypted-media; picture-in-picture"
										referrerpolicy="strict-origin-when-cross-origin"
										tabindex="-1"
									></iframe>
									{/* Covers YouTube's own start-up UI: a 1280x720 frame of the video, or a custom poster */}
									<img
										class="media cover"
										src={item.poster ?? `https://i.ytimg.com/vi/${item.youtube}/maxres1.jpg`}
										alt=""
									/>
									{/* Blocks hover/click on YouTube's own UI so only our buttons control it */}
									<div class="absolute inset-0" aria-hidden="true"></div>
								</>
							) : (
								<video class="media" src={item.src} autoplay muted loop playsinline preload="metadata"></video>
							)}
							<div class="absolute top-3 right-3 z-10 flex gap-2">
								<button
									type="button"
									class="ctrl"
									data-action="mute"
									aria-label={t("gallery.unmute")}
									data-label-on={t("gallery.mute")}
									data-label-off={t("gallery.unmute")}
								>
									<svg viewBox="0 0 16 16" class="icon-muted" aria-hidden="true"><path d="M2 6h3l4-3v10L5 10H2z" fill="currentColor"/><path d="M11 6l4 4M15 6l-4 4" stroke="currentColor" stroke-width="1.5"/></svg>
									<svg viewBox="0 0 16 16" class="icon-sound" aria-hidden="true"><path d="M2 6h3l4-3v10L5 10H2z" fill="currentColor"/><path d="M11 5.5a3.5 3.5 0 0 1 0 5M12.5 3.5a6 6 0 0 1 0 9" stroke="currentColor" stroke-width="1.3" fill="none"/></svg>
								</button>
								<button
									type="button"
									class="ctrl"
									data-action="play"
									aria-label={t("gallery.pause")}
									data-label-on={t("gallery.play")}
									data-label-off={t("gallery.pause")}
								>
									<svg viewBox="0 0 16 16" class="icon-pause" aria-hidden="true"><path d="M4 3h3v10H4zM9 3h3v10H9z" fill="currentColor"/></svg>
									<svg viewBox="0 0 16 16" class="icon-play" aria-hidden="true"><path d="M5 3l8 5-8 5z" fill="currentColor"/></svg>
								</button>
							</div>
						</div>
					)}

					<span class="badge">{num(i)}</span>
					{(item.caption || item.source) && (
						<div class="caption">
							{item.caption && <p>{item.caption}</p>}
							{item.source && (
								<a href={item.source.url} target="_blank" rel="noopener noreferrer">{item.source.label} ↗</a>
							)}
						</div>
					)}
				</li>
			))}
		</ul>
	</main>
</Layout>

<style>
	.media {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border: 0;
		transition: filter 400ms;
	}
	/* YouTube player scaled up so its title bar and bottom bar fall outside the tile */
	.yt {
		top: 50%;
		left: 50%;
		width: auto;
		height: calc(100% + 140px);
		aspect-ratio: 16 / 9;
		transform: translate(-50%, -50%);
	}
	.cover {
		transition: opacity 900ms ease-out, filter 400ms;
	}
	/* Widescreen films have black bands inside the 16:9 video: zoom in so the picture
	   fills the tile (2.39:1 inside 16:9 -> about 1.35x) */
	.letterbox .cover {
		transform: scale(1.35);
	}
	.letterbox .yt {
		height: 136%;
	}
	.video.has-started .cover {
		opacity: 0;
	}
	/* Paused -> grey */
	.video.is-paused .media {
		filter: grayscale(1);
	}

	/* Overlay controls in the portfolio's pill style (same as the social links) */
	.badge,
	.ctrl,
	.caption {
		position: absolute;
		z-index: 10;
		border: 1px solid rgb(255 255 255 / 0.1);
		background: rgb(0 0 0 / 0.45);
		backdrop-filter: blur(12px);
		color: #fff;
	}
	.badge {
		top: 0.75rem;
		left: 0.75rem;
		border-radius: 9999px;
		padding: 0.2rem 0.65rem;
		font-size: 0.75rem;
		font-weight: 500;
		color: rgb(255 255 255 / 0.85);
	}
	.caption {
		right: 0.75rem;
		bottom: 0.75rem;
		left: 0.75rem;
		margin-left: auto;
		width: fit-content;
		max-width: min(28rem, 100%);
		border-radius: 0.75rem;
		padding: 0.6rem 0.9rem;
		font-size: 0.875rem;
		line-height: 1.45;
		color: rgb(255 255 255 / 0.9);
		text-wrap: pretty;
	}
	.caption a {
		display: inline-flex;
		margin-top: 0.25rem;
		font-size: 0.75rem;
		color: rgb(255 255 255 / 0.6);
		transition: color 150ms;
	}
	/* Phones: smaller box so it doesn't cover the video */
	@media (max-width: 639.98px) {
		.caption {
			right: 0.5rem;
			bottom: 0.5rem;
			left: 0.5rem;
			padding: 0.4rem 0.65rem;
			font-size: 0.75rem;
			line-height: 1.35;
		}
		.caption a {
			font-size: 0.6875rem;
		}
	}
	.caption a:hover {
		color: #fff;
		text-decoration: underline;
	}
	.ctrl {
		position: static;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 9999px;
		cursor: pointer;
		transition: transform 150ms, background-color 150ms;
	}
	.ctrl:hover {
		background: rgb(255 255 255 / 0.15);
		transform: scale(1.1);
	}
	@media (prefers-reduced-motion: reduce) {
		.ctrl:hover {
			transform: none;
		}
	}
	.ctrl:focus-visible,
	.caption a:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}
	.ctrl svg {
		width: 14px;
		height: 14px;
		display: none;
	}
	/* Icons show the current state: muted -> crossed speaker, playing -> pause */
	.video.is-muted .icon-muted,
	.video:not(.is-muted) .icon-sound,
	.video.is-paused .icon-play,
	.video:not(.is-paused) .icon-pause {
		display: block;
	}
</style>

<script>
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	document.querySelectorAll<HTMLElement>(".video").forEach((card) => {
		const mute = card.querySelector<HTMLButtonElement>('[data-action="mute"]')!;
		const play = card.querySelector<HTMLButtonElement>('[data-action="play"]')!;
		let muted = true;
		let paused = false;

		// Same interface for a <video> file and a YouTube iframe
		let player: { play(): void; pause(): void; setMuted(m: boolean): void };
		const video = card.querySelector("video");
		const iframe = card.querySelector("iframe");
		if (video) {
			card.classList.add("has-started");
			player = {
				play: () => void video.play(),
				pause: () => video.pause(),
				setMuted: (m) => (video.muted = m),
			};
		} else {
			const send = (func: string, args: unknown[] = []) =>
				iframe!.contentWindow?.postMessage(JSON.stringify({ event: "command", func, args }), "*");
			player = {
				play: () => send("playVideo"),
				pause: () => send("pauseVideo"),
				setMuted: (m) => send(m ? "mute" : "unMute"),
			};

			let starting = true;
			let revealTimer: ReturnType<typeof setTimeout> | undefined;

			// Ask the player to report its state, so the buttons and the grey filter follow
			// what is really happening (e.g. when the browser blocks autoplay)
			const listen = () =>
				iframe!.contentWindow?.postMessage(JSON.stringify({ event: "listening", id: 1, channel: "widget" }), "*");
			iframe!.addEventListener("load", listen);
			window.addEventListener("message", (e) => {
				if (e.source !== iframe!.contentWindow || typeof e.data !== "string") return;
				let msg: { event?: string; info?: unknown };
				try {
					msg = JSON.parse(e.data);
				} catch {
					return;
				}
				const info = msg.info as { playerState?: number } | number | undefined;
				const state = typeof info === "number" ? (msg.event === "onStateChange" ? info : undefined) : info?.playerState;
				if (state === undefined) return;
				// 1 = playing, 2 = paused, 0 = ended, 3 = buffering, -1/5 = not started
				if (state === 0) {
					// Loop by hand (see youtubeSrc) and cover the restart like the first start
					card.classList.remove("has-started");
					clearTimeout(revealTimer);
					starting = true;
					send("seekTo", [0, true]);
					send("playVideo");
					return;
				}
				// YouTube shows its own play button for a few seconds whenever playback starts:
				// keep the cover on top until it has faded out
				if (state === 1 && starting) {
					starting = false;
					revealTimer = setTimeout(() => card.classList.add("has-started"), 4000);
				}
				if (state === 1 || state === 2) {
					paused = state === 2;
					sync();
				}
			});
		}

		const sync = () => {
			card.classList.toggle("is-muted", muted);
			card.classList.toggle("is-paused", paused);
			mute.setAttribute("aria-label", (muted ? mute.dataset.labelOff : mute.dataset.labelOn) ?? "");
			play.setAttribute("aria-label", (paused ? play.dataset.labelOn : play.dataset.labelOff) ?? "");
		};

		mute.addEventListener("click", () => {
			muted = !muted;
			player.setMuted(muted);
			sync();
		});
		play.addEventListener("click", () => {
			paused = !paused;
			paused ? player.pause() : player.play();
			sync();
		});

		if (reduceMotion) {
			paused = true;
			if (video) video.pause();
			iframe?.addEventListener("load", () => player.pause(), { once: true });
		}
		sync();
	});
</script>
